{
  "name": "dsh-rule-proxy",
  "version": "0.1.1",
  "description": "Isolated hostname-rule transport for DSH web tools",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/provider.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "rules.json",
    "docs",
    "README.md",
    "LICENSE",
    "TEST_REPORT.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "proxy",
    "network",
    "http-proxy",
    "web-fetch",
    "hostname-rules"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoyi728/dsh-rule-proxy.git"
  },
  "homepage": "https://github.com/xiaoyi728/dsh-rule-proxy#readme",
  "bugs": {
    "url": "https://github.com/xiaoyi728/dsh-rule-proxy/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/client.js",
    "test:browser": "node test/browser.mjs",
    "test:package": "node test/package-smoke.mjs",
    "diagnose": "node src/cli.js"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "ipaddr.js": "^2.5.0",
    "isomorphic-git": "^1.37.3",
    "re2-wasm": "^1.0.2",
    "undici": "^8.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5",
    "@deepseek-ai/dsh-web": ">=0.2.0-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.2.0-rc.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
